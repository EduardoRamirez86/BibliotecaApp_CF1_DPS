@model IEnumerable<BibliotecaApp.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3">
            <i class="bi bi-arrow-left"></i> Volver al Inicio
        </a>
        <h2 class="fw-bold text-center m-0" style="color: #003366; flex-grow: 1;">Catálogo de Libros UDB</h2>
        <div style="width: 140px;"></div> 
    </div>

    <p class="text-center mb-5 text-muted">Explora nuestra colección y verifica la disponibilidad de ejemplares.</p>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var libro in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-light">
                    <div class="card-header text-center py-3 border-0" style="background-color: #003366;">
                        <h5 class="card-title mb-0 text-truncate text-white fw-bold" title="@libro.Titulo">
                            @libro.Titulo
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-4 mt-2">
                            <span style="font-size: 3rem; color: #cbd5e1;">📖</span>
                        </div>
                        <p class="card-text mb-2 text-secondary">
                            <strong style="color: #003366;">Autor:</strong> @libro.Autor
                        </p>
                        <p class="card-text mb-2 text-secondary">
                            <strong style="color: #003366;">Género:</strong> @libro.Genero
                        </p>
                        <div class="mt-4 text-center">
                            @if (libro is BibliotecaApp.Models.LibroFisico libroFisico)
                            {
                                if ((libroFisico.StockTotal - libroFisico.StockPrestado) > 0)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">Agotado</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-primary px-3 py-2 rounded-pill">Libro Digital</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-center pb-4 pt-2">
                        <a asp-controller="Libro" asp-action="Detalle" asp-route-id="@libro.Id" class="btn text-white w-100 fw-bold rounded-3" style="background-color: #003366; padding: 12px;">
                            Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>