@model BibliotecaApp.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
    Layout = "_Layout";
    bool esBibliotecario = User.IsInRole("BIBLIOTECARIO") || User.IsInRole("Bibliotecario");
}

<div class="container mt-5 mb-5">
    <div class="card shadow border-0 rounded-4 overflow-hidden bg-light">
        <div class="card-header text-center" style="background-color: #003366; padding: 15px 25px;">
            <h3 class="mb-0 text-white fw-bold"><i class="bi bi-book-half me-2"></i> Información del Ejemplar</h3>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <div class="bg-white rounded-4 p-5 border border-2 border-dashed shadow-sm">
                        <span style="font-size: 7rem; color: #94a3b8;">📖</span>
                    </div>
                </div>

                <div class="col-md-8 ps-md-5">
                    <h2 class="fw-bold mb-2" style="color: #003366;">@Model.Titulo</h2>
                    <h5 class="text-muted mb-4">Por: <strong class="text-dark">@Model.Autor</strong></h5>

                    <div class="row mb-4">
                        <div class="col-sm-6 mb-3">
                            <span class="text-muted small">Género Literario</span><br />
                            <strong class="fs-6">@Model.Genero</strong>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <span class="text-muted small">Año de Publicación</span><br />
                            <strong class="fs-6">@Model.AnioPublicacion</strong>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <span class="text-muted small">Código ISBN</span><br />
                            <strong class="fs-6">@Model.ISBN</strong>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <span class="text-muted small">Disponibilidad en Biblioteca</span><br />
                            @if (Model is BibliotecaApp.Models.LibroFisico libroFisico)
                            {
                                if (libroFisico.StockDisponible > 0)
                                {
                                    <span class="badge bg-success px-3 py-2 mt-1">
                                        Disponible (@libroFisico.StockDisponible de @libroFisico.StockTotal en estante: @libroFisico.UbicacionEstante)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 mt-1">
                                        Agotado (0 de @libroFisico.StockTotal disponibles)
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-primary px-3 py-2 mt-1">Libro Digital</span>
                            }
                        </div>
                    </div>

                    <hr class="text-muted my-4" />

                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show fw-bold text-center mb-3 border-0 rounded-3" role="alert">
                            <i class="bi bi-check-circle me-2"></i> @TempData["Mensaje"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show fw-bold text-center mb-3 border-0 rounded-3" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <form asp-controller="Prestamo" asp-action="Solicitar" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idLibro" value="@Model.Id" />
                            <button type="submit" class="btn text-white fw-bold rounded-3 px-4 py-2" style="background-color: #003366;">
                                <i class="bi bi-bookmark-plus me-1"></i> Solicitar Préstamo
                            </button>
                        </form>

                        @if (esBibliotecario)
                        {
                            <a asp-controller="Libro" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning fw-bold rounded-3 px-4 py-2">
                                <i class="bi bi-pencil me-1"></i> Modificar Ejemplar
                            </a>

                            <form asp-controller="Libro" asp-action="Eliminar" asp-route-id="@Model.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger fw-bold rounded-3 px-4 py-2">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </button>
                            </form>
                        }

                        <a asp-controller="Libro" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3 px-4 py-2 ms-auto">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>