@model (string Titulo, string Subtitulo, bool EsSubtituloDorado)

<div class="auth-header">
    <div class="auth-logo-badge">
        <picture>
            <source srcset="~/images/logo-udb-vertical.svg" type="image/svg+xml" />
            <img src="~/images/logo-udb-vertical.png" alt="Universidad Don Bosco" class="auth-logo-img" />
        </picture>
    </div>

    <h1 class="auth-title">@Model.Titulo</h1>
    @if (Model.EsSubtituloDorado)
    {
        <p class="auth-subtitle-gold">@Model.Subtitulo</p>
    }
    else
    {
        <p class="auth-subtitle-gray">@Model.Subtitulo</p>
    }
</div>
<!-- MÓDULO AUTH: Gestiona la seguridad del sistema mediante controladores (Login, Register, Logout), 
 validación de DTOs con Data Annotations, cifrado de contraseñas, asignación de roles (Estudiante, Docente, Bibliotecario), 
 creación de cookies de sesión con Claims y protección obligatoria contra ataques CSRF ([ValidateAntiForgeryToken]). -->