<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca UDB</title>
    <style>
        :root {
            --udb-blue-dark: #002b5c;
            --udb-blue-primary: #004b93;
            --udb-blue-hover: #00366b;
            --udb-gold: #d49b14;
            --udb-bg: #f4f7fb;
            --udb-card-bg: #ffffff;
            --udb-text-dark: #1e293b;
            --udb-text-muted: #64748b;
            --udb-input-bg: #f8fafc;
            --udb-input-border: #e2e8f0;
            --udb-danger: #ef4444;
            --udb-success: #10b981;
            --udb-radius: 12px;
            --udb-font: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body.auth-body {
            font-family: var(--udb-font);
            background-color: var(--udb-bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 16px;
            color: var(--udb-text-dark);
        }

        .auth-container {
            width: 100%;
            max-width: 440px;
            margin: auto;
        }

        .auth-card {
            background: var(--udb-card-bg);
            border-radius: 20px;
            padding: 36px 30px;
            box-shadow: 0 10px 30px rgba(0, 43, 92, 0.08);
            border: 1px solid #e2e8f0;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .auth-logo-badge {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 12px;
        }

        .auth-logo-badge picture {
            display: inline-flex;
            justify-content: center;
        }

        .auth-logo-img {
            max-width: 125px;
            width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
            object-fit: contain;
        }

        .auth-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--udb-blue-dark);
            margin-bottom: 4px;
            letter-spacing: -0.3px;
        }

        .auth-subtitle-gold {
            font-size: 14px;
            font-weight: 600;
            color: var(--udb-gold);
            margin-bottom: 4px;
        }

        .auth-subtitle-gray {
            font-size: 14px;
            color: var(--udb-text-muted);
            margin-bottom: 4px;
        }

        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            text-align: left;
        }

        .form-label {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--udb-blue-dark);
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            background-color: var(--udb-input-bg);
            border: 1.5px solid var(--udb-input-border);
            border-radius: var(--udb-radius);
            font-size: 14px;
            font-family: inherit;
            color: var(--udb-text-dark);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control::placeholder {
            color: #94a3b8;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: var(--udb-blue-primary);
            box-shadow: 0 0 0 3px rgba(0, 75, 147, 0.12);
        }

        .form-control.input-password {
            padding-right: 44px;
        }

        .password-toggle-btn {
            position: absolute;
            right: 10px;
            background: transparent;
            border: none;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #64748b;
        }

        .password-toggle-btn:hover {
            color: var(--udb-blue-primary);
        }

        .password-toggle-btn svg {
            width: 20px;
            height: 20px;
        }

        select.form-control {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23004b93' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 14px center;
            background-size: 16px;
            cursor: pointer;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--udb-text-muted);
            cursor: pointer;
        }

        .form-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--udb-blue-primary);
            cursor: pointer;
        }

        .btn-primary-udb {
            width: 100%;
            padding: 13px 20px;
            background-color: var(--udb-blue-primary);
            color: #ffffff;
            border: none;
            border-radius: var(--udb-radius);
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;
            box-shadow: 0 4px 14px rgba(0, 75, 147, 0.25);
            margin-top: 4px;
        }

        .btn-primary-udb:hover {
            background-color: var(--udb-blue-hover);
            transform: translateY(-1px);
        }

        .btn-primary-udb:active {
            transform: translateY(0);
        }

        .auth-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: var(--udb-text-muted);
        }

        .auth-footer a {
            color: var(--udb-blue-primary);
            font-weight: 700;
            text-decoration: none;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .text-danger {
            color: var(--udb-danger);
            font-size: 12px;
            margin-top: 2px;
            font-weight: 500;
        }

        .alert {
            padding: 11px 14px;
            border-radius: var(--udb-radius);
            font-size: 13px;
            margin-bottom: 14px;
        }

        .alert-danger {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .alert-success {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .welcome-container {
            max-width: 650px;
            margin: 40px auto;
            background: #ffffff;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
            text-align: center;
        }

        .role-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 16px;
        }

        .role-badge.estudiante {
            background-color: #e0f2fe;
            color: #0369a1;
        }

        .role-badge.docente {
            background-color: #fef3c7;
            color: #b45309;
        }

        .role-badge.bibliotecario {
            background-color: #dcfce7;
            color: #15803d;
        }
    </style>
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="auth-card">
            @RenderBody()
        </div>
    </div>

    <!-- Script Reutilizable para Toggle de Visibilidad de Contraseñas -->
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;

            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';

            btn.innerHTML = isPassword
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                     <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                     <line x1="1" y1="1" x2="23" y2="23"></line>
                   </svg>`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                     <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                     <circle cx="12" cy="12" r="3"></circle>
                   </svg>`;
        }
    </script>
</body>
</html>
