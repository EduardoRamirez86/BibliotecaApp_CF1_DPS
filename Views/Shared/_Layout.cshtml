<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca UDB</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-udb {
            background-color: #002b5c;
            border-bottom: 3px solid #d49b14;
        }

        .nav-link {
            font-weight: 500;
            transition: color 0.2s ease-in-out;
        }

        .nav-link:hover {
            color: #d49b14 !important;
        }

        .role-pill {
            font-size: 11px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .role-pill-bibliotecario {
            background-color: #d49b14;
            color: #002b5c;
        }

        .role-pill-estudiante {
            background-color: #0284c7;
            color: #ffffff;
        }

        .role-pill-docente {
            background-color: #059669;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-udb shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-2 fs-4 text-warning"></i>
                    <span>Biblioteca UDB</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarUdbContent" aria-controls="navbarUdbContent" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarUdbContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Libro" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1"></i> Catálogo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Prestamo" asp-action="Index">
                                <i class="bi bi-card-checklist me-1"></i> Mis Préstamos
                            </a>
                        </li>
                        @if (User.IsInRole("BIBLIOTECARIO") || User.IsInRole("Bibliotecario"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Libro" asp-action="Crear">
                                    <i class="bi bi-plus-circle me-1"></i> Nuevo Libro
                                </a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";
                        var rolClass = rol.ToLowerInvariant() switch
                        {
                            "bibliotecario" => "role-pill-bibliotecario",
                            "estudiante" => "role-pill-estudiante",
                            "docente" => "role-pill-docente",
                            _ => "bg-secondary text-white"
                        };

                        <div class="d-flex align-items-center gap-3">
                            <div class="text-white text-end d-none d-sm-block">
                                <div class="fw-bold" style="font-size: 14px;">@User.Identity.Name</div>
                                <span class="role-pill @rolClass">@rol</span>
                            </div>

                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-light rounded-3 fw-bold px-3 py-1">
                                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 container pb-5 pt-3">
        @RenderBody()
    </main>

    <footer class="border-top text-center py-4 mt-auto bg-white" style="color: #64748b; font-size: 14px;">
        <div class="container">
            &copy; @DateTime.Now.Year - Sistema de Gestión Bibliotecaria · Universidad Don Bosco (UDB)
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>