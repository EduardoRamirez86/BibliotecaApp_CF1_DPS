<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca UDB</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
            body {
                background-color: #f1f5f9;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            }

            .navbar-udb {
                background-color: #003366; 
            }
    </style>
</head>
<body>
   
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-udb shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-2"></i> Biblioteca UDB
                </a>
                <div class="d-flex align-items-center">
                    <a asp-controller="Prestamo" asp-action="Index" class="btn btn-outline-light btn-sm fw-bold me-3 rounded-3">
                        📖 Mis Préstamos
                    </a>
                    <span class="navbar-text text-white">
                        Módulo Administrativo
                    </span>
                </div>
                <div class="d-flex">
                    <span class="navbar-text text-white">
                        Módulo Administrativo
                    </span>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container pb-5">
        @RenderBody()
    </main>

    <footer class="border-top text-center py-4 mt-auto" style="background-color: white; color: #64748b; font-size: 14px;">
        <div class="container">
            &copy; @DateTime.Now.Year - Sistema de Gestión de Préstamos - Universidad Don Bosco
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>