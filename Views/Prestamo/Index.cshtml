@model IEnumerable<BibliotecaApp.Models.Prestamo>

@{
    ViewData["Title"] = "Mis Préstamos";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <h2 class="fw-bold m-0" style="color: #003366;">Historial de Préstamos</h2>
        <a asp-controller="Libro" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-3">
            <i class="bi bi-plus-circle"></i> Solicitar Nuevo
        </a>
    </div>

    <!-- Alertas de éxito o error -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success fw-bold text-center mb-4 border-0 rounded-3">
            <i class="bi bi-check-circle me-2"></i> @TempData["Mensaje"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold text-center mb-4 border-0 rounded-3">
            <i class="bi bi-exclamation-circle me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="card shadow border-0 rounded-4 overflow-hidden bg-light">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-white" style="background-color: #003366;">
                    <tr>
                        <th class="py-3 px-4">Libro</th>
                        <th class="py-3">Fecha de Préstamo</th>
                        <th class="py-3">Devolución Esperada</th>
                        <th class="py-3 text-center">Estado</th>
                        <th class="py-3 px-4 text-end">Acción</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <span style="font-size: 3rem;">📭</span><br />
                                <h5 class="mt-3">No tienes préstamos registrados</h5>
                            </td>
                        </tr>
                    }
                    @foreach (var prestamo in Model)
                    {
                        <tr>
                            <td class="py-3 px-4 fw-bold" style="color: #003366;">
                                @(prestamo.Libro?.Titulo ?? "Libro Desconocido")
                            </td>
                            <td class="py-3 text-muted">@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                            <td class="py-3 text-muted">@prestamo.FechaDevolucionEsperada.ToString("dd/MM/yyyy")</td>
                            <td class="py-3 text-center">
                                @if (prestamo.EstaActivo)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">Devuelto</span>
                                }
                            </td>
                            <td class="py-3 px-4 text-end">
                                @if (prestamo.EstaActivo)
                                {
                                    <form asp-controller="Prestamo" asp-action="Devolver" method="post" class="m-0">
                                        <input type="hidden" name="idPrestamo" value="@prestamo.Id" />
                                        <button type="submit" class="btn btn-sm text-white fw-bold rounded-3 px-3 py-2" style="background-color: #003366;">
                                            Devolver Libro
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-light fw-bold rounded-3 px-3 py-2 text-muted" disabled>
                                        Completado
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>