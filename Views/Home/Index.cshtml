@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Inicio";
    string rol = (string)(ViewBag.RolUsuario ?? "");
    string rolClass = rol.ToLowerInvariant() switch
    {
        "estudiante" => "estudiante",
        "docente" => "docente",
        "bibliotecario" => "bibliotecario",
        _ => ""
    };
}

<div class="welcome-container" style="box-shadow: none; border: none; padding: 0;">
    <!-- Logo UDB Header (Actualizamos el ¡Hola Mundo! a algo más profesional) -->
    <partial name="_AuthHeader" model='("Dashboard Principal", "Sistema de Gestión de Préstamos - Biblioteca UDB", true)' />

    <div style="margin: 20px 0; text-align: center;">
        <span class="role-badge @rolClass">Rol: @ViewBag.RolUsuario</span>
        <h2 style="font-size: 20px; color: var(--udb-blue-dark); margin-bottom: 8px;">
            ¡Bienvenido(a), @ViewBag.NombreUsuario!
        </h2>
        <p style="color: var(--udb-text-muted); font-size: 14px;">
            Sesión activa: <strong>@ViewBag.EmailUsuario</strong>
        </p>
    </div>

    <!-- Botones de acceso rápido -->
    <div style="margin: 25px 0; display: flex; flex-direction: column; gap: 12px;">
        <a asp-controller="Libro" asp-action="Index" class="btn-primary-udb" style="display: block; text-decoration: none; padding: 14px; font-size: 15px; font-weight: bold; width: 100%;">
            <i class="bi bi-book me-2"></i> Explorar Catálogo de Libros
        </a>

        @if (rol.Equals("Bibliotecario", StringComparison.OrdinalIgnoreCase))
        {
            <a asp-controller="Libro" asp-action="Crear" class="btn-primary-udb" style="display: block; text-decoration: none; padding: 14px; font-size: 15px; font-weight: bold; width: 100%; background-color: var(--udb-gold); color: #002b5c;">
                <i class="bi bi-plus-circle me-2"></i> Registrar Nuevo Libro (Admin)
            </a>
        }

        <a asp-controller="Prestamo" asp-action="Index" class="btn-primary-udb" style="display: block; text-decoration: none; padding: 14px; font-size: 15px; font-weight: bold; width: 100%; background-color: #0284c7;">
            <i class="bi bi-card-checklist me-2"></i> Mis Préstamos Registrados
        </a>
    </div>

    <!-- Formulario de Cerrar Sesión (Mantenemos intacto el trabajo de tu compañero) -->
    <form asp-controller="Auth" asp-action="Logout" method="post" style="display: block; text-align: center; margin-top: 15px;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-primary-udb" style="background-color: #475569; width: 100%;">
            Cerrar Sesión
        </button>
    </form>
</div>