@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Inicio";
    string rol = (string)(ViewBag.RolUsuario ?? "");
    string rolClass = rol.ToLowerInvariant() switch
    {
        "estudiante" => "estudiante",
        "docente" => "docente",
        "bibliotecario" => "bibliotecario",
        _ => ""
    };
}

<div class="welcome-container" style="box-shadow: none; border: none; padding: 0;">
    <!-- Logo UDB Header -->
    <partial name="_AuthHeader" model='("¡Hola Mundo!", "Sistema de Gestión de Préstamos - Biblioteca UDB", true)' />

    <div style="margin: 20px 0; text-align: center;">
        <span class="role-badge @rolClass">Rol: @ViewBag.RolUsuario</span>
        <h2 style="font-size: 20px; color: var(--udb-blue-dark); margin-bottom: 8px;">
            ¡Bienvenido(a), @ViewBag.NombreUsuario!
        </h2>
        <p style="color: var(--udb-text-muted); font-size: 14px;">
            Sesión activa: <strong>@ViewBag.EmailUsuario</strong>
        </p>
    </div>

    <div style="background-color: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 18px; margin: 20px 0; text-align: left; font-size: 13.5px; line-height: 1.6; color: #475569;">
        <p style="font-weight: 700; color: var(--udb-blue-primary); margin-bottom: 4px;">✓ Módulo de Seguridad Verificado</p>
        <p>Autenticación por Cookies, roles (@ViewBag.RolUsuario) y cifrado seguro PBKDF2/SHA256 operando con éxito.</p>
    </div>

    <form asp-controller="Auth" asp-action="Logout" method="post" style="display: block; text-align: center;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-primary-udb" style="background-color: #475569; width: 100%;">
            Cerrar Sesión
        </button>
    </form>
</div>