@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Inicio";
    string rol = (string)(ViewBag.RolUsuario ?? "");
    string rolClass = rol.ToLowerInvariant() switch
    {
        "estudiante" => "estudiante",
        "docente" => "docente",
        "bibliotecario" => "bibliotecario",
        _ => ""
    };
}

<div class="welcome-container" style="box-shadow: none; border: none; padding: 0;">
    <!-- Logo UDB Header (Actualizamos el ¡Hola Mundo! a algo más profesional) -->
    <partial name="_AuthHeader" model='("Dashboard Principal", "Sistema de Gestión de Préstamos - Biblioteca UDB", true)' />

    <div style="margin: 20px 0; text-align: center;">
        <span class="role-badge @rolClass">Rol: @ViewBag.RolUsuario</span>
        <h2 style="font-size: 20px; color: var(--udb-blue-dark); margin-bottom: 8px;">
            ¡Bienvenido(a), @ViewBag.NombreUsuario!
        </h2>
        <p style="color: var(--udb-text-muted); font-size: 14px;">
            Sesión activa: <strong>@ViewBag.EmailUsuario</strong>
        </p>
    </div>

    <!-- Botón de acceso al Catálogo (Nuestra nueva integración) -->
    <div style="margin: 30px 0; text-align: center;">
        <a asp-controller="Libro" asp-action="Index" class="btn-primary-udb" style="display: block; text-decoration: none; padding: 16px; font-size: 16px; font-weight: bold; width: 100%;">
            <i class="bi bi-book me-2"></i> Explorar el Catálogo de Libros
        </a>
    </div>

    <!-- Formulario de Cerrar Sesión (Mantenemos intacto el trabajo de tu compañero) -->
    <form asp-controller="Auth" asp-action="Logout" method="post" style="display: block; text-align: center; margin-top: 15px;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-primary-udb" style="background-color: #475569; width: 100%;">
            Cerrar Sesión
        </button>
    </form>
</div>